# Copy to runtime.env on the TARGET computer. docker --env-file uses literal
# values: do not use quotes or ${VARIABLE} interpolation here.
DEPLOYMENT_PROFILE=aramco
LLM_API_URL=https://dev-metabrain-api.aramco.com.sa/v1/chat/completions
LLM_MODEL=minimaxm3
LLM_API_KEY=REPLACE_LLM_KEY
LENS_API_KEY=REPLACE_LENS_KEY

# Keep the actual approved embedding endpoint/model/protocol together.
# This app currently uses BGE (1024 dimensions). If using another model,
# configure its real name and its matching endpoint explicitly.
EMBEDDING_API_URL=REPLACE_EMBEDDING_URL
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_API_FORMAT=huggingface
EMBEDDING_API_KEY=REPLACE_EMBEDDING_KEY

# Optional HTTP(S) proxy / company CA. Never disable TLS verification.
# HTTPS_PROXY=http://your-approved-proxy:port
# HTTP_PROXY=http://your-approved-proxy:port
NO_PROXY=localhost,127.0.0.1
# REQUESTS_CA_BUNDLE=/certs/company-ca.pem
# SSL_CERT_FILE=/certs/company-ca.pem

# AUTH_SECRET is generated on first start and kept in the data volume.
TRACE=0
