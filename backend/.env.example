# Hugging Face inference token.
# Required. Backs both the LLM calls (llm.py) and the embedding calls
# (embeddings.py) - there is no separate embedding credential.
HF_TOKEN=your_huggingface_token_here

# SerpApi key, used for the Google Patents search source.
# Required: Google Patents is currently the only enabled provider.
# https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# EPO Open Patent Services (OPS) API credentials.
# Currently unused - the EPO provider is commented out of SOURCES in
# backend/search/search.py while its OPS auth is being throttled. Keep these set
# so re-enabling it is a one-line change.
# https://developers.epo.org/
EPO_CONSUMER_KEY=your_epo_ops_consumer_key_here
EPO_CONSUMER_SECRET=your_epo_ops_consumer_secret_here

# Optional overrides - defaults shown below
# LLM_API_URL=https://router.huggingface.co/v1/chat/completions
# LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct:novita
# EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Qdrant, from the repository-root docker-compose.yml. Required: the graph's
# semantic-search branch reads it and index_patents writes it, with no fallback
# on either side. The default below already matches that compose file; override
# only if you changed the published port or point at a shared instance.
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=

# PostgreSQL, from the repository-root docker-compose.yml. Required: every
# completed run is stored before its result is sent, and GET /api/history and
# the login lookup both read it, with no fallback on any of the three. The
# default below already matches that compose file; override only if you changed
# the published port or point at a shared instance.
# DATABASE_URL=postgresql://agenticai:agenticai@127.0.0.1:5432/agenticai

# HMAC key the session tokens in backend/auth.py are signed with. The default is
# a known constant checked into config.py, so ANY backend that does not set this
# will accept a token minted by anyone who has read this repository. Set it to a
# real random value (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
# before exposing the backend beyond localhost. Changing it invalidates every
# issued token, which is also the only way to revoke one.
# AUTH_SECRET=
# AUTH_SESSION_HOURS=12

# Set TRACE=0 to silence the per-step trace printed to stdout on every request.
# TRACE=0
